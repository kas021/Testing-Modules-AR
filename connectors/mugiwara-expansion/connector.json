{
  "schemaVersion": 1,
  "id": "mugiwara-expansion",
  "familyID": "mugiwara-expansion",
  "name": "Mugiwara (BETA - SUB TV testing)",
  "version": "0.1.0",
  "minimumAppVersion": "2.0.36",
  "requiredEngineFeatures": [
    "literal-json-records-v1",
    "literal-declarations-v1",
    "aligned-episode-panels-v1",
    "named-episode-groups-v1",
    "unique-nested-call-v1",
    "literal-text-encoding-v1",
    "literal-object-projection-v1",
    "bounded-mirrors-v1"
  ],
  "contentType": "video",
  "language": "fr",
  "contentRating": "unknown",
  "releaseTrack": "beta",
  "status": "active",
  "authorization": {
    "basis": "personal",
    "note": "Experimental declarative connector. Use only content you are entitled to access; no third-party content or distribution rights are supplied."
  },
  "allowedHosts": [
    "www.mugiwara-no-streaming.com",
    "image.tmdb.org",
    "video.sibnet.ru",
    "*.sibnet.ru",
    "ansembed.net"
  ],
  "capabilities": [
    "search",
    "details",
    "episodes",
    "streams"
  ],
  "limits": {
    "timeoutMilliseconds": 8000,
    "maxConcurrentRequests": 2,
    "maxResponseBytes": 4194304
  },
  "operations": {
    "search": {
      "request": {
        "method": "POST",
        "urlTemplate": "https://www.mugiwara-no-streaming.com/api/catalogue-filters?page={page}",
        "headers": {
          "Referer": "https://www.mugiwara-no-streaming.com/",
          "Accept": "application/json"
        },
        "body": "{\"input\":\"{query}\",\"page\":\"{page}\",\"itemsPerPage\":20}"
      },
      "response": {
        "format": "json"
      },
      "pagination": {
        "type": "pageParam",
        "start": 1,
        "maxPages": 25
      },
      "items": {
        "collection": "animes[*]",
        "fields": {
          "sourceID": {
            "path": "slug"
          },
          "title": {
            "path": "anime"
          },
          "posterURL": {
            "path": "wallpaper"
          }
        }
      }
    },
    "details": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://www.mugiwara-no-streaming.com/catalogue/{titleID}/episodes",
        "headers": {
          "Referer": "https://www.mugiwara-no-streaming.com/"
        }
      },
      "response": {
        "format": "literal-selection",
        "scriptSelector": "script:containsData(animeServer)",
        "selection": {
          "kind": "calls",
          "name": "self.__next_f.push"
        },
        "jsonRecords": {
          "argumentPath": "[0][1]",
          "objectKey": "animeServer",
          "recordID": "21"
        }
      },
      "extract": {
        "title": {
          "path": "anime"
        },
        "synopsis": {
          "path": "synopsis"
        },
        "sharedID": {
          "path": "options.EPISODES_OPTIONS.SCRIPT_URL"
        }
      }
    },
    "episodes": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://www.mugiwara-no-streaming.com/catalogue/{titleID}/episodes",
        "headers": {
          "Referer": "https://www.mugiwara-no-streaming.com/"
        }
      },
      "response": {
        "format": "literal-selection",
        "scriptSelector": "script:containsData(animeServer)",
        "selection": {
          "kind": "calls",
          "name": "self.__next_f.push"
        },
        "jsonRecords": {
          "argumentPath": "[0][1]",
          "objectKey": "animeServer",
          "recordID": "21"
        }
      },
      "extract": {
        "collection": "options.saisons[*]",
        "fields": {
          "episodeID": {
            "path": "name"
          },
          "seasonNumber": {
            "path": "id",
            "transforms": [
              {
                "op": "firstInteger"
              }
            ]
          }
        }
      },
      "panels": {
        "listURL": {
          "path": "id",
          "transforms": [
            {
              "op": "template",
              "value": "https://www.mugiwara-no-streaming.com/api/episodes-script?url={sharedID}saison{value}/vostfr/episodes.js",
              "encodeValue": true
            }
          ]
        },
        "variant": {
          "literal": "sub"
        },
        "response": {
          "format": "literal-declarations"
        },
        "arrays": [
          "eps3[*]",
          "eps1[*]",
          "eps2[*]"
        ],
        "maxPanels": 50,
        "headers": {
          "Referer": "https://www.mugiwara-no-streaming.com/"
        }
      }
    },
    "streams": {
      "mirrors": [
        {
          "variants": [
            "sub"
          ],
          "inputHosts": [
            "video.sibnet.ru"
          ],
          "finalMediaPolicy": "public-https",
          "steps": [
            {
              "request": {
                "method": "GET",
                "follow": "episodeURL",
                "headers": {
                  "Referer": "https://www.mugiwara-no-streaming.com/"
                }
              },
              "response": {
                "format": "literal-selection",
                "textEncoding": "windows-1251",
                "scriptSelector": "script:containsData(player.src)",
                "selection": {
                  "kind": "unique-nested-call",
                  "name": "player.src"
                }
              },
              "extract": {
                "collection": "calls[0][0][*]",
                "fields": {
                  "url": {
                    "path": "src",
                    "transforms": [
                      {
                        "op": "absolutize"
                      }
                    ]
                  },
                  "mediaTypeHint": {
                    "literal": "mp4"
                  }
                }
              }
            }
          ]
        },
        {
          "variants": [
            "sub"
          ],
          "inputHosts": [
            "ansembed.net"
          ],
          "finalMediaPolicy": "public-https",
          "steps": [
            {
              "request": {
                "method": "GET",
                "follow": "episodeURL",
                "headers": {
                  "Referer": "https://www.mugiwara-no-streaming.com/"
                }
              },
              "response": {
                "format": "literal-selection",
                "scriptSelector": "script:containsData(player.setup)",
                "selection": {
                  "kind": "call-object-fields",
                  "name": "player.setup",
                  "properties": [
                    "sources"
                  ]
                }
              },
              "extract": {
                "collection": "value.sources[*]",
                "fields": {
                  "url": {
                    "path": "file",
                    "transforms": [
                      {
                        "op": "absolutize"
                      }
                    ]
                  },
                  "mediaTypeHint": {
                    "literal": "hls"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  },
  "releaseNotes": "Research-only SUB television pilot. Films, Kai, inline episode lists, DUB, fixed-record stability and full native certification remain unverified. Do not publish."
}
