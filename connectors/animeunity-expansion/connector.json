{
  "schemaVersion": 1,
  "id": "animeunity-expansion",
  "familyID": "animeunity-expansion",
  "name": "AnimeUnity (BETA - Playback blocked)",
  "version": "0.1.0",
  "minimumAppVersion": "2.0.36",
  "requiredEngineFeatures": [
    "public-source-session-v1",
    "checked-pagination-v1",
    "episode-pagination-v1",
    "line-literal-assignment-v1",
    "encoded-query-v1"
  ],
  "contentType": "video",
  "language": "it",
  "contentRating": "unknown",
  "releaseTrack": "beta",
  "status": "active",
  "authorization": {
    "basis": "personal",
    "note": "Experimental declarative connector. Use only content you are entitled to access; no third-party content or distribution rights are supplied."
  },
  "allowedHosts": [
    "www.animeunity.so",
    "animeunity.so",
    "vixcloud.co"
  ],
  "publicSourceSession": {
    "bootstrapURL": "https://www.animeunity.so/",
    "csrfSelector": "meta[name=csrf-token]",
    "cookieNames": [
      "animeunity_session"
    ],
    "lifetimeSeconds": 120
  },
  "capabilities": [
    "search",
    "details",
    "episodes",
    "streams"
  ],
  "limits": {
    "timeoutMilliseconds": 8000,
    "maxConcurrentRequests": 2,
    "maxResponseBytes": 1048576
  },
  "operations": {
    "search": {
      "request": {
        "method": "POST",
        "urlTemplate": "https://www.animeunity.so/archivio/get-animes?limit={limit}",
        "headers": {
          "Accept": "application/json",
          "X-Requested-With": "XMLHttpRequest",
          "Origin": "https://www.animeunity.so",
          "Referer": "https://www.animeunity.so/archivio"
        },
        "body": "{\"title\":\"{query}\",\"type\":false,\"year\":false,\"order\":\"popolarita\",\"status\":false,\"genres\":false,\"offset\":\"{offset}\",\"dubbed\":false,\"season\":false}"
      },
      "response": {
        "format": "json"
      },
      "pagination": {
        "type": "offset",
        "start": 1,
        "pageSize": 30,
        "firstItem": 0,
        "maxPages": 25
      },
      "items": {
        "collection": {
          "path": "records[*]",
          "where": [
            {
              "path": "dub",
              "equals": "0"
            }
          ]
        },
        "fields": {
          "sourceID": {
            "path": "id"
          },
          "title": {
            "path": "title_eng",
            "fallbacks": [
              {
                "path": "title"
              }
            ]
          }
        }
      }
    },
    "details": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://www.animeunity.so/anime/{titleID}-anime"
      },
      "response": {
        "format": "html-attr-json",
        "selector": "video-player",
        "attribute": "anime"
      },
      "extract": {
        "title": {
          "path": "title_eng",
          "fallbacks": [
            {
              "path": "title"
            }
          ]
        },
        "sharedID": {
          "path": "slug"
        },
        "synopsis": {
          "path": "plot"
        }
      }
    },
    "episodes": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://www.animeunity.so/info_api/{titleID}/{sharedID}?start_range={rangeStart}&end_range={rangeEnd}"
      },
      "response": {
        "format": "json"
      },
      "pagination": {
        "type": "inclusiveRange",
        "start": 1,
        "firstItem": 1,
        "pageSize": 120,
        "maxPages": 20
      },
      "extract": {
        "collection": "episodes[*]",
        "fields": {
          "episodeID": {
            "path": "id"
          },
          "episodeNumber": {
            "path": "number"
          },
          "title": {
            "path": "file_name"
          }
        }
      }
    },
    "streams": {
      "playbackHeaders": {
        "Referer": "https://vixcloud.co/",
        "Origin": "https://vixcloud.co"
      },
      "variants": [
        "sub"
      ],
      "finalMediaPolicy": "public-https",
      "steps": [
        {
          "request": {
            "method": "GET",
            "urlTemplate": "https://www.animeunity.so/embed-url/{episodeID}",
            "headers": {
              "Referer": "https://www.animeunity.so/"
            }
          },
          "response": {
            "format": "html"
          },
          "extract": {
            "context": {
              "embed": {
                "kind": "url",
                "selector": "body",
                "part": "text",
                "transforms": [
                  {
                    "op": "trim"
                  }
                ]
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "follow": "embed",
            "headers": {
              "Referer": "https://www.animeunity.so/"
            }
          },
          "response": {
            "format": "literal-selection",
            "scriptSelector": "script:containsData(window.masterPlaylist)",
            "selection": {
              "kind": "assignment",
              "name": "window.masterPlaylist",
              "lineTerminatedAssignment": true
            }
          },
          "extract": {
            "context": {
              "token": {
                "path": "value.params.token"
              },
              "expires": {
                "path": "value.params.expires"
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "follow": "embed",
            "headers": {
              "Referer": "https://www.animeunity.so/"
            }
          },
          "response": {
            "format": "literal-selection",
            "scriptSelector": "script:containsData(window.streams)",
            "selection": {
              "kind": "assignment",
              "name": "window.streams"
            }
          },
          "extract": {
            "collection": "value[*]",
            "fields": {
              "url": {
                "path": "url",
                "transforms": [
                  {
                    "op": "appendQuery",
                    "items": {
                      "token": "{token}",
                      "expires": "{expires}"
                    }
                  }
                ]
              },
              "mediaTypeHint": {
                "literal": "hls"
              }
            }
          }
        }
      ]
    }
  },
  "releaseNotes": "Research candidate: native resolver pilot. SUB-only test selection; full audio classification, public session expiry, mirrors, 50-title and device gates remain unverified. Do not publish."
}
