{
  "schemaVersion": 1,
  "id": "aniworld-expansion",
  "familyID": "aniworld-expansion",
  "name": "Aniworld (BETA - SUB testing)",
  "version": "0.3.0",
  "minimumAppVersion": "2.0.36",
  "requiredEngineFeatures": [
    "form-post-v1",
    "mapped-episode-panels-v1",
    "html-text-v1",
    "literal-object-projection-v1",
    "empty-json-collection-v1",
    "bounded-mirrors-v1"
  ],
  "contentType": "video",
  "language": "mul",
  "contentRating": "unknown",
  "releaseTrack": "beta",
  "status": "active",
  "authorization": {
    "basis": "personal",
    "note": "Experimental declarative connector. Use only content you are entitled to access; no third-party content or distribution rights are supplied."
  },
  "allowedHosts": [
    "aniworld.to",
    "vidmoly.net",
    "vidmoly.biz"
  ],
  "capabilities": [
    "search",
    "details",
    "episodes",
    "streams"
  ],
  "limits": {
    "timeoutMilliseconds": 8000,
    "maxConcurrentRequests": 2,
    "maxResponseBytes": 4194304
  },
  "operations": {
    "search": {
      "request": {
        "method": "POST",
        "urlTemplate": "https://aniworld.to/ajax/search",
        "formFields": {
          "keyword": "{query}"
        },
        "headers": {
          "Referer": "https://aniworld.to/search",
          "X-Requested-With": "XMLHttpRequest"
        }
      },
      "response": {
        "format": "json-empty-array"
      },
      "items": {
        "collection": "[*]",
        "fields": {
          "sourceID": {
            "path": "link",
            "transforms": [
              {
                "op": "lastPathComponent"
              }
            ]
          },
          "title": {
            "path": "title",
            "transforms": [
              {
                "op": "htmlText"
              }
            ]
          }
        }
      }
    },
    "details": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://aniworld.to/anime/stream/{titleID}"
      },
      "response": {
        "format": "html"
      },
      "extract": {
        "title": {
          "selector": "h1",
          "part": "text"
        },
        "synopsis": {
          "selector": "[data-full-description]",
          "part": "attr",
          "attr": "data-full-description"
        },
        "posterURL": {
          "selector": ".seriesCoverBox img",
          "part": "attr",
          "attr": "data-src",
          "transforms": [
            {
              "op": "absolutize"
            }
          ]
        }
      }
    },
    "episodes": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://aniworld.to/anime/stream/{titleID}"
      },
      "response": {
        "format": "html"
      },
      "extract": {
        "collection": "#stream a[href*='/staffel-']:not([href*='/episode-'])",
        "fields": {
          "episodeID": {
            "selector": "a",
            "part": "attr",
            "attr": "href",
            "transforms": [
              {
                "op": "lastPathComponent"
              }
            ]
          },
          "seasonNumber": {
            "selector": "a",
            "part": "attr",
            "attr": "href",
            "transforms": [
              {
                "op": "lastPathComponent"
              },
              {
                "op": "firstInteger"
              }
            ]
          }
        }
      },
      "panels": {
        "listURL": {
          "selector": "a",
          "part": "attr",
          "attr": "href",
          "transforms": [
            {
              "op": "absolutize"
            }
          ]
        },
        "variant": {
          "literal": "sub"
        },
        "response": {
          "format": "html"
        },
        "maxPanels": 50,
        "items": {
          "collection": "tr[data-episode-id]",
          "fields": {
            "episodeNumber": {
              "selector": "a[href*='/episode-']",
              "part": "attr",
              "attr": "href",
              "transforms": [
                {
                  "op": "lastPathComponent"
                },
                {
                  "op": "firstInteger"
                }
              ]
            },
            "episodeURL": {
              "selector": "a[href*='/episode-']",
              "part": "attr",
              "attr": "href",
              "transforms": [
                {
                  "op": "absolutize"
                }
              ]
            },
            "title": {
              "selector": "strong",
              "part": "text"
            }
          }
        }
      }
    },
    "streams": {
      "mirrors": [
        {
          "variants": [
            "sub"
          ],
          "inputHosts": [
            "aniworld.to"
          ],
          "finalMediaPolicy": "public-https",
          "steps": [
            {
              "request": {
                "method": "GET",
                "follow": "episodeURL"
              },
              "response": {
                "format": "html"
              },
              "extract": {
                "context": {
                  "embed": {
                    "kind": "url",
                    "selector": "li[data-lang-key='3'][data-link-target]:has(h4:contains(Vidmoly))",
                    "part": "attr",
                    "attr": "data-link-target",
                    "transforms": [
                      {
                        "op": "absolutize"
                      }
                    ]
                  }
                }
              }
            },
            {
              "request": {
                "method": "GET",
                "follow": "embed",
                "headers": {
                  "Referer": "https://aniworld.to/"
                }
              },
              "response": {
                "format": "literal-selection",
                "scriptSelector": "script:containsData(player.setup)",
                "selection": {
                  "kind": "call-object-fields",
                  "name": "player.setup",
                  "properties": [
                    "sources"
                  ]
                }
              },
              "extract": {
                "collection": "value.sources[*]",
                "fields": {
                  "url": {
                    "path": "file",
                    "transforms": [
                      {
                        "op": "absolutize"
                      }
                    ]
                  },
                  "mediaTypeHint": {
                    "literal": "hls"
                  }
                }
              }
            }
          ]
        },
        {
          "variants": [
            "sub"
          ],
          "inputHosts": [
            "aniworld.to"
          ],
          "finalMediaPolicy": "public-https",
          "steps": [
            {
              "request": {
                "method": "GET",
                "follow": "episodeURL"
              },
              "response": {
                "format": "html"
              },
              "extract": {
                "context": {
                  "embed": {
                    "kind": "url",
                    "selector": "li[data-lang-key='2'][data-link-target]:has(h4:contains(Vidmoly))",
                    "part": "attr",
                    "attr": "data-link-target",
                    "transforms": [
                      {
                        "op": "absolutize"
                      }
                    ]
                  }
                }
              }
            },
            {
              "request": {
                "method": "GET",
                "follow": "embed",
                "headers": {
                  "Referer": "https://aniworld.to/"
                }
              },
              "response": {
                "format": "literal-selection",
                "scriptSelector": "script:containsData(player.setup)",
                "selection": {
                  "kind": "call-object-fields",
                  "name": "player.setup",
                  "properties": [
                    "sources"
                  ]
                }
              },
              "extract": {
                "collection": "value.sources[*]",
                "fields": {
                  "url": {
                    "path": "file",
                    "transforms": [
                      {
                        "op": "absolutize"
                      }
                    ]
                  },
                  "mediaTypeHint": {
                    "literal": "hls"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  },
  "releaseNotes": "Local research: German-caption SUB route first, English-caption SUB route second; neither falls back to dubbed audio. Caption/spoken-language verification and iPhone gates remain unverified. Do not publish."
}
